# Copiar a .env en la raíz. Nunca publicar este archivo con valores reales.
DATABASE_URL=postgresql+psycopg://cardmatica:CHANGE_ME@127.0.0.1:55432/cardmatica
POSTGRES_PORT=55432
POSTGRES_USER=cardmatica
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cardmatica
ADMIN_TOKEN=
USER_AGENT=Cardmatica/0.2 (local catalog maintenance)
YGOPRODECK_ENABLED=true
YGOPRODECK_REQUEST_INTERVAL=1.0
DEPLOYMENT_MODE=production
# Solo validación local sin explotación comercial; no acredita una licencia comercial.
ALLOW_LOCAL_IMAGE_PREVIEW=false
KONAMI_ENABLED=false
# Referencia verificable al permiso escrito para extracción y reutilización comercial.
KONAMI_AUTHORIZATION_REFERENCE=
YUGIPEDIA_ENABLED=false
YUGIPEDIA_REQUEST_INTERVAL=1.0
# Konami se conserva únicamente como procedencia histórica de importaciones autorizadas.
HTTP_TIMEOUT=25
HTTP_RETRIES=3
CACHE_DIRECTORY=.cache/http
IMAGE_DIRECTORY=data/images
# Sin permisos explícitos por imagen, solo se guarda metadata y se muestra un fallback.
CORS_ORIGINS=["http://localhost:8000","http://localhost:5500"]

# Dominios a los que responde el sitio. "*" acepta cualquiera; en producción, el dominio real.
ALLOWED_HOSTS=["*"]
# Cuentas: duración de la sesión ("mantener la sesión" en días, sin ella en horas),
# intentos fallidos antes del bloqueo temporal y su duración, intentos por IP y minuto.
SESSION_DAYS=30
SESSION_SHORT_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
AUTH_ATTEMPTS_PER_MINUTE=10
# Correo: "console" escribe cada correo en el registro (docker compose logs api);
# "smtp" lo envía con el servidor indicado. PUBLIC_BASE_URL es la dirección de
# los enlaces de los correos (vacío: la del sitio desde el que se pidió).
EMAIL_BACKEND=console
EMAIL_FROM=Cardmática <no-responder@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
PUBLIC_BASE_URL=
EMAIL_CONFIRMATION_HOURS=48
PASSWORD_RESET_MINUTES=60
